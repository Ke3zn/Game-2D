[sub_resource type="Shader" id="Shader_prologue_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_amount : hint_range(0.0, 6.0) = 3.2;
uniform float dim_amount : hint_range(0.0, 1.0) = 0.25;

void fragment() {
	vec4 col = textureLod(screen_texture, SCREEN_UV, blur_amount);
	col.rgb = mix(col.rgb, vec3(0.0), dim_amount);
	COLOR = vec4(col.rgb, COLOR.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_prologue_blur"]
shader = SubResource("Shader_prologue_blur")
shader_parameter/blur_amount = 3.2
shader_parameter/dim_amount = 0.25

